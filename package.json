{
  "name": "mymouse",
  "version": "1.1.0",
  "description": "Use your phone as a touchpad for your PC",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "author": "bykamronbek",
  "license": "ISC",
  "dependencies": {
    "@nut-tree/nut-js": "^3.1.2",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bykamronbek.mymouse",
    "productName": "MyMouse",
    "files": [
      "main.js",
      "index.html",
      "public/**/*",
      "gui/**/*",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@nut-tree/libnut-win32/build/Release/libnut.node",
        "to": "native/libnut.node"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  }
}
